{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Resolve like Metro: Button.native.tsx before Button.tsx.
    "customConditions": ["react-native"],
    "moduleSuffixes": [".native", ""],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["uniwind/types"],
    "paths": {
      "@ui/*": ["./src/components/ui/*"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.native.tsx", "src/**/*.native.ts"]
}
