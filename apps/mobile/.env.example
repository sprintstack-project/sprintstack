# Public auth origin (the web app, which proxies /api/auth to the API). Use a LAN IP or tunnel on
# a physical device, and set BETTER_AUTH_URL in apps/api to the same value.
EXPO_PUBLIC_AUTH_URL=http://localhost:3001
# The API's GraphQL endpoint, reached directly (not through the web app).
EXPO_PUBLIC_API_URL=http://localhost:3000/graphql

# PostHog error tracking (src/lib/posthog.ts): Project settings → Project API key, and the
# ingestion host (e.g. https://eu.i.posthog.com). Built into the app via app.config.ts. Without them
# errors go to Crashlytics only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
