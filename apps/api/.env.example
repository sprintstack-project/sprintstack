# Local (native Postgres / Postgres.app): your macOS user, no password.
#   DATABASE_URL=postgresql://<your-user>@localhost:5432/sprintstack
# Local (Docker): matches docker-compose.yml at the repo root.
#   DATABASE_URL=postgresql://sprintstack:sprintstack@localhost:5432/sprintstack
# Railway: set DATABASE_URL to the reference variable ${{Postgres.DATABASE_URL}}
# (private network URL, no egress fees).
DATABASE_URL=postgresql://sprintstack:sprintstack@localhost:5432/sprintstack
DATABASE_POOL_MAX=10
PORT=3000
