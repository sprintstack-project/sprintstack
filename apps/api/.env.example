# Local (native Postgres / Postgres.app): your macOS user, no password.
#   DATABASE_URL=postgresql://<your-user>@localhost:5432/sprintstack
# Local (Docker): matches docker-compose.yml at the repo root.
#   DATABASE_URL=postgresql://sprintstack:sprintstack@localhost:5432/sprintstack
# Railway: set DATABASE_URL to the reference variable ${{Postgres.DATABASE_URL}}
# (private network URL, no egress fees).
DATABASE_URL=postgresql://sprintstack:sprintstack@localhost:5432/sprintstack
DATABASE_SCHEMA=app
DATABASE_POOL_MAX=10
PORT=3000

# Better Auth. Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin that serves /api/auth: the web app, which proxies that path to this API.
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
# Deep-link scheme of the mobile app (apps/mobile/app.json "scheme").
APP_SCHEME=sprintstack
# Extra comma-separated trusted origins (e.g. staging web URLs).
TRUSTED_ORIGINS=
# GitHub OAuth app: callback URL is <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Passkeys are bound to this domain (defaults to WEB_ORIGIN's hostname). Native apps need it to be
# a real domain serving /.well-known files, so they can't use passkeys against localhost.
PASSKEY_RP_ID=
# Extra WebAuthn origins for native apps, comma-separated:
#   https://<PASSKEY_RP_ID>,android:apk-key-hash:<base64url SHA-256 of the signing cert>
PASSKEY_ORIGINS=

# Mailjet (Account settings → API key management). Without the key pair, development logs emails
# to the console instead of sending them. The sender must be a validated Mailjet sender/domain.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=no-reply@sprintstack.io
MAIL_FROM_NAME=SprintStack
