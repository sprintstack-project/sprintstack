{
  "name": "storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project=storybook",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.json",
    "lint": "biome check",
    "format": "biome format --write",
    "storybook:native": "expo start --port 8083",
    "storybook:native:ios": "expo start --ios --port 8083",
    "storybook:native:stories": "sb-rn-get-stories --config-path .rnstorybook"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@sprintstack/forms": "workspace:^",
    "@sprintstack/shared": "workspace:^",
    "@sprintstack/ui": "workspace:^",
    "@storybook/addon-ondevice-actions": "^10.7.0",
    "@storybook/addon-ondevice-controls": "^10.7.0",
    "@storybook/react-native": "^10.7.0",
    "@storybook/react-native-ui-lite": "^10.7.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "lucide-react": "^1.61.0",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-actions-sheet": "^11.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.13.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "latest"
  },
  "main": "expo-router/entry"
