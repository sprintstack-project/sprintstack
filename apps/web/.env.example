# The NestJS API; /api/auth/* is rewritten to it (next.config.ts). On Railway use the private
# address (http://<service>.railway.internal:<port>) so the API needs no public domain: the API
# trusts cf-connecting-ip for rate limiting, which only holds if every request came via Cloudflare.
API_URL=http://localhost:3000

# Native passkeys: the mobile app's identities, served from /.well-known so iOS and Android trust
# this domain (PASSKEY_RP_ID in apps/api). Apple: <TEAM_ID>.com.sprintstack.app
APPLE_APP_IDS=
# Android: comma-separated SHA-256 fingerprints of the app signing certificate (AA:BB:...); also
# verifies the app's App Links. Include the Play App Signing key, not just the upload key.
ANDROID_CERT_FINGERPRINTS=

# Browser pushes through Firebase Cloud Messaging. Firebase console → Project settings → General →
# Your apps → the web app's config. Without them the bell still works, just without pushes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
