# The NestJS API; /api/auth/* is rewritten to it (next.config.ts).
API_URL=http://localhost:3000

# Native passkeys: the mobile app's identities, served from /.well-known so iOS and Android trust
# this domain (PASSKEY_RP_ID in apps/api). Apple: <TEAM_ID>.com.sprintstack.app
APPLE_APP_IDS=
# Android: comma-separated SHA-256 fingerprints of the app signing certificate (AA:BB:...).
ANDROID_CERT_FINGERPRINTS=
